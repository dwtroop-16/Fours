# Postgres (Neon). When unset, FOURS uses embedded PGlite under .data/fours-pg
DATABASE_URL=

# Protect Vercel Cron: Authorization: Bearer <secret>
CRON_SECRET=change-me

# Meta Marketing API (optional — without these, Meta sync stays in mock mode)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_0000000000
META_GRAPH_VERSION=v22.0

# Optional per-campaign budget object override (ad set id when not using CBO)
# META_BUDGET_OBJECT_camp_meta_lean_broad=120000000000000000
